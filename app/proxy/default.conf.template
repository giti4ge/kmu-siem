# KMU-SIEM – Reverse Proxy (nginx + ModSecurity + OWASP CRS)
# Ersetzt die Standard-Vorlage des Images. Variablen ${…} setzt der Entrypoint (envsubst).
# Extern erreichbar ist nur Port 443 (per nftables auf 8443 umgeleitet); 8080 nur lokal.

server_tokens off;
more_clear_headers Server;

# Nur lokal: Gesundheitsprüfung und Weiterleitung auf HTTPS
server {
    listen 127.0.0.1:${PORT};
    location /healthz { access_log off; default_type text/plain; return 200 "OK"; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen ${SSL_PORT} ssl;
    http2 on;

    ssl_certificate     /etc/nginx/siem-certs/web.crt;
    ssl_certificate_key /etc/nginx/siem-certs/web.key;
    ssl_protocols TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SIEMTLS:10m;
    ssl_session_tickets off;

    # Sicherheits-Header (OWASP ASVS)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()" always;
    add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    client_max_body_size 10m;

    # Gesundheitsprüfung für externes Monitoring (ohne Anmeldung, ohne Details)
    location = /health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    # REST-API der Control-Plane
    location /api/ {
        proxy_pass ${BACKEND};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Überschreiben statt anhängen: Client kann keine eigene Adresse vorgeben
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
        client_max_body_size 1m;
    }

    # OpenSearch Dashboards mit SSO: nginx fragt die Control-Plane (Sitzungs-Cookie) und
    # erhält ein kurzlebiges JWT, das als Authorization-Header weitergereicht wird.
    location /dashboards/ {
        auth_request /_sso_dashboards;
        auth_request_set $siem_jwt $upstream_http_x_siem_jwt;
        error_page 401 403 = @login;
        # Rohes JWT – Dashboards setzt das „Bearer“-Präfix beim Weiterreichen selbst
        proxy_set_header Authorization $siem_jwt;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
        proxy_pass http://127.0.0.1:5601;
        # Eigene CSP von Dashboards gilt; übrige Sicherheits-Header hier erneut (add_header erbt nicht)
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
    }
    location = /_sso_dashboards {
        internal;
        proxy_pass ${BACKEND}/api/auth/sso/dashboards;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
    location @login {
        return 302 /;
    }

    # Web-UI (SPA): unbekannte Pfade liefern index.html (Client-Routing)
    root /usr/share/nginx/siem;
    # Kein add_header in den locations – sonst entfallen die Sicherheits-Header des Servers
    location /assets/ {
        expires 30d;
        try_files $uri =404;
    }
    location / {
        expires -1;
        try_files $uri /index.html;
    }
}
