# Antwortdatei für die unbeaufsichtigte Installation
#
#   cp antworten.env.example antworten.env
#   nano antworten.env
#   sudo ./install.sh --unattended antworten.env
#
# Format: SCHLÜSSEL=WERT (eine Angabe je Zeile). Werte mit Leerzeichen in "…".
# Die Datei wird nicht ausgeführt, sondern nur gelesen; unbekannte Schlüssel
# führen zum Abbruch. Geheimnisse bitte über *_FILE als Dateipfad angeben.

# --- Allgemein ---------------------------------------------------------------
SIEM_LANG=de                                  # de | en
SIEM_FQDN=siem.firma.local                    # Pflicht, muss per DNS auflösbar sein
SIEM_NTP=dc01.firma.local,dc02.firma.local    # Pflicht, kommagetrennt

# --- Proxy (optional) --------------------------------------------------------
SIEM_PROXY=                                   # z. B. http://proxy.firma.local:3128
SIEM_PROXY_CA_FILE=                           # CA-Datei bei TLS-Inspection

# --- Daten-Disk --------------------------------------------------------------
SIEM_DATA_DISK=/dev/sdb                       # Pflicht; "none" = keine zweite Disk
SIEM_DATA_DISK_CONFIRM=yes                    # Pflicht bei Disk: Disk wird GELÖSCHT

# --- Zugänge -----------------------------------------------------------------
SIEM_ADMIN_SSH_KEY_FILE=/home/install/siemadmin.pub   # empfohlen; ohne Key bleibt SSH-Kennwort aktiv
SIEM_ADMIN_PASSWORD_FILE=/root/.siem-admin-pw         # Pflicht, Kennwort ≥ 12 Zeichen (erste Zeile)
SIEM_WEB_ADMIN_PASSWORD_FILE=/root/.siem-web-pw       # Pflicht, Kennwort ≥ 12 Zeichen (erste Zeile)
SIEM_KEEP_INSTALLER_USER_SSH=                         # yes = SSH-Zugang des Installationsbenutzers behalten

# --- VLAN-Trunk für ARP-Guard (optional) -------------------------------------
SIEM_TRUNK_IF=                                # z. B. ens224
SIEM_TRUNK_VLANS=                             # z. B. 10,20,30-40

# --- Updates über GitHub -----------------------------------------------------
SIEM_GITHUB_TOKEN_FILE=                       # nur bei privatem Distributions-Repository

# --- Verhalten ---------------------------------------------------------------
SIEM_ACCEPT_WARNINGS=                         # yes = bei Preflight-Warnungen trotzdem installieren
